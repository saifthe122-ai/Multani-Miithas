# Copy to .env.local for local development.
# Never commit real credentials or production secrets.

# Canonical website URL. Set this to the purchased domain after DNS and HTTPS are ready.
SITE_URL=https://your-domain.example

# Neon PostgreSQL connection string (use the pooled connection string for serverless hosting).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Admin login password. Use a long, unique password (at least 16 characters).
ADMIN_PASSWORD=replace-with-a-long-unique-password

# HMAC signing secret for admin sessions. Must be at least 32 characters.
# Generate a unique random value; never reuse the example.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Current media uploader uses Vercel Blob. Required only while that uploader remains enabled.
# Keep this secret server-side; never expose it with a NEXT_PUBLIC_ prefix.
BLOB_READ_WRITE_TOKEN=

# Optional store identifier used when validating/replacing older Vercel Blob media.
BLOB_STORE_ID=

# Media storage provider:
# - vercel_blob (default): requires BLOB_READ_WRITE_TOKEN
# - local: writes outside versioned releases to ~/.multani-mithas/uploads by default
#   (or set MEDIA_STORAGE_DIRECTORY to an absolute persistent path)
MEDIA_STORAGE_DRIVER=vercel_blob

# Public business contact details shown on the customer website.
# Use international format for WhatsApp, e.g. 923001234567 (digits only).
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_EMAIL=

# Optional absolute persistent directory for local media; leave blank to use ~/.multani-mithas/uploads
MEDIA_STORAGE_DIRECTORY=
